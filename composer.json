{
    "name": "osd84/discord-bundle",
    "description": "Symfony bundle: send alerts to a Discord channel through a webhook (curl, no HTTP client).",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "discord", "webhook", "alert"],
    "authors": [
        {"name": "osd84", "homepage": "https://github.com/osd84"}
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.4"
    },
    "autoload": {
        "psr-4": {"Osd84\\DiscordBundle\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Osd84\\DiscordBundle\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true
    }
}
